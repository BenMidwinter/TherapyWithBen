---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteUrl = (Astro.site?.href ?? 'https://therapywithben.uk').replace(/\/$/, '');
const {
  title = 'Therapy With Ben | Integrative Psychotherapy in Walthamstow, London',
  description = 'Integrative psychotherapy with Ben in Walthamstow, East London. Trauma-informed support for people who have tried therapy before, or felt it wasn’t for them — and are ready for a better fit.',
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, `${siteUrl}/`).href;
const ogImage = new URL('/og-image.jpg', `${siteUrl}/`).href;
const isHome = pathname === '/' || pathname === '';

const personId = `${siteUrl}/#ben`;
const orgId = `${siteUrl}/#practice`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Therapy With Ben',
      description,
      inLanguage: 'en-GB',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: isHome ? { '@id': orgId } : undefined,
      inLanguage: 'en-GB',
    },
    {
      '@type': 'ProfessionalService',
      '@id': orgId,
      name: 'Therapy With Ben',
      alternateName: 'Therapy With Ben — Ben Richardson',
      description,
      url: siteUrl,
      email: 'hello@therapywithben.uk',
      image: ogImage,
      inLanguage: 'en-GB',
      areaServed: [
        {
          '@type': 'Place',
          name: 'Walthamstow, Waltham Forest, London, E17',
        },
        {
          '@type': 'AdministrativeArea',
          name: 'Greater London',
        },
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Walthamstow',
        addressRegion: 'London',
        postalCode: 'E17',
        addressCountry: 'GB',
      },
      founder: { '@id': personId },
      employee: { '@id': personId },
      parentOrganization: {
        '@type': 'Organization',
        name: 'That Music Therapy Lot',
        url: 'https://thatmusictherapylot.uk/',
      },
      sameAs: [
        'https://thatmusictherapylot.uk/',
        'https://www.the-ncip.org/',
        'https://www.hcpc-uk.org/',
      ],
      knowsAbout: [
        'Integrative psychotherapy',
        'Acceptance and Commitment Therapy',
        'Trauma',
        'Anxiety',
        'Emotional-Based School Avoidance',
        'Neurodivergence',
        'Adolescents and young adults',
      ],
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Ben Richardson',
      jobTitle: 'Integrative Psychotherapist',
      url: `${siteUrl}/#about`,
      worksFor: { '@id': orgId },
      knowsAbout: [
        'Integrative psychotherapy',
        'Music therapy',
        'Acceptance and Commitment Therapy',
      ],
      sameAs: ['https://thatmusictherapylot.uk/'],
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="integrative psychotherapy Walthamstow, therapist East London, trauma therapy London, therapy for adolescents, ACT therapy, therapy after failed therapy, HCPC music therapist, NCIP, Therapy With Ben"
    />
    <meta name="author" content="Ben Richardson" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="GB-LND" />
    <meta name="geo.placename" content="Walthamstow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Therapy With Ben" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Therapy With Ben — integrative psychotherapy in East London" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Therapy With Ben — integrative psychotherapy in East London" />

    <meta name="theme-color" content="#eef3f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Karla:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.site-nav');

      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          nav.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced) {
        const reveals = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' }
        );
        reveals.forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
